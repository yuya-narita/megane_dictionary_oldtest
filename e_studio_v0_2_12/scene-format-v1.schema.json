{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scene.studio/schema/scene-format-v1.schema.json",
  "title": "Scene Format v1.0",
  "type": "object",
  "required": [
    "format",
    "version",
    "language",
    "title",
    "author",
    "theme",
    "scenes"
  ],
  "properties": {
    "format": {
      "const": "scene-format"
    },
    "version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "workId": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "pattern": "^(?:mul|und|[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*)$"
    },
    "title": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "theme": {
      "enum": [
        "light",
        "dark",
        "cinema"
      ]
    },
    "preset": {
      "type": "string",
      "minLength": 1
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    },
    "player": {
      "$ref": "#/$defs/player"
    },
    "appearance": {
      "type": "object",
      "properties": {
        "cinemaTone": {
          "enum": [
            "dark",
            "light"
          ]
        },
        "typography": {
          "type": "object",
          "properties": {
            "fontFamily": {
              "enum": [
                "serif",
                "sans",
                "mono"
              ]
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
      },
      "uniqueItems": true
    },
    "direction": {
      "enum": [
        "auto",
        "ltr",
        "rtl"
      ]
    }
  },
  "additionalProperties": true,
  "$defs": {
    "scene": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "text",
            "dialogue",
            "sound"
          ]
        },
        "text": {
          "type": "string"
        },
        "subText": {
          "type": "string"
        },
        "pause": {
          "type": "number",
          "minimum": 0
        },
        "presentation": {
          "$ref": "#/$defs/presentation"
        },
        "audio": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/audioCommand"
          }
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        },
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
        },
        "direction": {
          "enum": [
            "auto",
            "ltr",
            "rtl"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "text",
                  "dialogue"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "text"
            ]
          }
        }
      ],
      "additionalProperties": true
    },
    "style": {
      "type": "object",
      "properties": {
        "color": {
          "type": "string"
        },
        "size": {
          "oneOf": [
            {
              "enum": [
                "auto",
                "small",
                "normal",
                "large",
                "xl"
              ]
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ]
        },
        "wrap": {
          "enum": [
            "auto",
            "nowrap"
          ]
        },
        "fontFamily": {
          "enum": [
            "serif",
            "sans",
            "mono"
          ]
        }
      },
      "additionalProperties": true
    },
    "presentation": {
      "type": "object",
      "properties": {
        "display": {
          "enum": [
            "stack",
            "solo"
          ]
        },
        "view": {
          "enum": [
            "world",
            "console",
            "system",
            "warning",
            "void"
          ]
        },
        "effect": {
          "enum": [
            "none",
            "blur",
            "fade",
            "loud",
            "pop",
            "pulse",
            "shake",
            "slow",
            "tilt",
            "whisper",
            "auto",
            "fadeRise",
            "softRise",
            "whisperIn",
            "emphasis",
            "settle"
          ]
        },
        "text": {
          "$ref": "#/$defs/style"
        },
        "subText": {
          "$ref": "#/$defs/style"
        },
        "typing": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "speed": {
              "type": "number",
              "minimum": 0
            },
            "cursor": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        "disappear": {
          "type": "object",
          "properties": {
            "after": {
              "type": "number",
              "minimum": 0
            },
            "fade": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": true
        },
        "background": {
          "$ref": "#/$defs/background"
        }
      },
      "additionalProperties": true
    },
    "background": {
      "type": "object",
      "properties": {
        "src": {
          "type": "string"
        },
        "transition": {
          "enum": [
            "fade",
            "cut",
            "flash",
            "glitch"
          ]
        },
        "dim": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "blur": {
          "type": "number",
          "minimum": 0
        },
        "fit": {
          "enum": [
            "cover",
            "contain"
          ]
        },
        "position": {
          "type": "string"
        },
        "reveal": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "none",
                "still",
                "intro",
                "memory",
                "ghost",
                "flash"
              ]
            },
            "duration": {
              "type": "number",
              "minimum": 0
            },
            "hold": {
              "type": "number",
              "minimum": 0
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": true
        },
        "motion": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "none",
                "parallax",
                "breath",
                "slowZoom",
                "panLeft",
                "panRight",
                "panUp",
                "panDown"
              ]
            },
            "duration": {
              "type": "number",
              "minimum": 0
            },
            "scaleFrom": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "scaleTo": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "pan": {
              "type": "number"
            }
          },
          "additionalProperties": true
        },
        "textures": {
          "type": "object",
          "properties": {
            "blur": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "grain": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "scanline": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "glitch": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "vignette": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "monochrome": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "audioCommand": {
      "type": "object",
      "required": [
        "channel",
        "action"
      ],
      "properties": {
        "channel": {
          "enum": [
            "bgm",
            "ambient",
            "oneshot"
          ]
        },
        "action": {
          "enum": [
            "start",
            "stop",
            "volume",
            "duck",
            "play"
          ]
        },
        "role": {
          "enum": [
            "voice",
            "se",
            "other"
          ]
        },
        "src": {
          "type": "string"
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "loop": {
          "type": "boolean"
        },
        "fadeIn": {
          "type": "number",
          "minimum": 0
        },
        "fadeOut": {
          "type": "number",
          "minimum": 0
        },
        "fade": {
          "type": "number",
          "minimum": 0
        },
        "hold": {
          "type": "number",
          "minimum": 0
        },
        "stopAfter": {
          "type": "number",
          "minimum": 0
        },
        "startAt": {
          "type": "number",
          "minimum": 0
        },
        "stopAt": {
          "type": "number",
          "minimum": 0
        },
        "restart": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "player": {
      "type": "object",
      "properties": {
        "navigation": {
          "type": "object",
          "properties": {
            "allowPrevious": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
