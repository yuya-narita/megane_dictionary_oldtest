{
  "format": "scene-format",
  "version": "1.0",
  "id": "scene-player-core-audio-demo.ja",
  "workId": "scene-player-core-audio-demo",
  "language": "ja",
  "title": "Audio Engine",
  "author": "Scene Studio",
  "theme": "dark",
  "scenes": [
    {
      "id": "s001",
      "type": "text",
      "text": "最初のTAPで、音が開く。",
      "subText": "BGMは読み込み時に予約。iPhoneでは最初の操作でunlock。",
      "pause": 3200,
      "presentation": {"display":"solo","effect":"fade","text":{"size":"large"}},
      "audio": [
        {"channel":"bgm","action":"start","src":"./assets/bgm-demo.wav","volume":0.30,"loop":true,"fadeIn":1200,"restart":true}
      ]
    },
    {
      "id": "s002",
      "type": "text",
      "text": "BGMは、そのまま残る。",
      "subText": "Sceneにaudio指定がなければ持続。",
      "pause": 2800
    },
    {
      "id": "s003",
      "type": "dialogue",
      "text": "環境音を、重ねる。",
      "subText": "ambient channel / loop — 低い風・空調音",
      "pause": 3000,
      "audio": [
        {"channel":"ambient","action":"start","src":"./assets/ambient-demo.wav","volume":0.22,"loop":true,"fadeIn":700}
      ]
    },
    {
      "id": "s004",
      "type": "sound",
      "text": "一度だけ鳴る。",
      "subText": "oneshot / role: se",
      "pause": 2400,
      "presentation": {"display":"solo","view":"system"},
      "audio": [
        {"channel":"oneshot","action":"play","role":"se","src":"./assets/se-demo.wav","volume":0.75}
      ]
    },
    {
      "id": "s005",
      "type": "dialogue",
      "text": "声が入る瞬間だけ、BGMを下げる。",
      "subText": "duck → hold → restore",
      "pause": 3300,
      "audio": [
        {"channel":"bgm","action":"duck","volume":0.08,"fade":220,"hold":1300},
        {"channel":"oneshot","action":"play","role":"voice","src":"./assets/voice-demo.wav","volume":0.72}
      ]
    },
    {
      "id": "s006",
      "type": "text",
      "text": "BGMの音量だけ変える。",
      "subText": "volume / fade 1000ms",
      "pause": 3000,
      "audio": [
        {"channel":"bgm","action":"volume","volume":0.16,"fade":1000}
      ]
    },
    {
      "id": "s007",
      "type": "text",
      "text": "環境音を止める。",
      "subText": "ambient stop / fadeOut",
      "pause": 3000,
      "audio": [
        {"channel":"ambient","action":"stop","fadeOut":900}
      ]
    },
    {
      "id": "s008",
      "type": "text",
      "text": "Audio EngineはCoreへ入った。",
      "subText": "‹ で戻るとBGM / Ambientの状態もそのScene時点へ復元。One-shotは再発火しない。",
      "pause": 3200,
      "presentation": {"display":"solo","view":"system","effect":"fade","text":{"size":"large"}},
      "audio": [
        {"channel":"bgm","action":"stop","fadeOut":1200}
      ]
    }
  ]
}
